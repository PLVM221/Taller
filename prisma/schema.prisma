generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum WorkOrderStatus {
  APPOINTMENT
  RECEIVED
  DIAGNOSIS
  WAITING_APPROVAL
  WAITING_PARTS
  REPAIRING
  QUALITY_CONTROL
  READY
  DELIVERED
}

enum Priority {
  LOW
  NORMAL
  HIGH
  URGENT
}

model Company {
  id        String   @id @default(cuid())
  name      String
  taxId     String?
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  branches  Branch[]
  users     User[]
  customers Customer[]
  suppliers Supplier[]

  @@map("companies")
}

model Branch {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  name      String
  address   String?
  timezone  String   @default("America/Argentina/Buenos_Aires")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")
  company   Company  @relation(fields: [companyId], references: [id])
  users     User[]
  orders    WorkOrder[]
  purchaseOrders PurchaseOrder[]

  @@index([companyId])
  @@map("branches")
}

model User {
  id           String   @id @default(cuid())
  companyId    String   @map("company_id")
  branchId     String?  @map("branch_id")
  name         String
  email        String   @unique
  passwordHash String   @map("password_hash")
  role         String   @default("ADMIN")
  active       Boolean  @default(true)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  company      Company  @relation(fields: [companyId], references: [id])
  branch       Branch?  @relation(fields: [branchId], references: [id])

  @@index([companyId])
  @@map("users")
}

model Customer {
  id            String   @id @default(cuid())
  companyId     String   @map("company_id")
  firstName     String   @map("first_name")
  lastName      String   @map("last_name")
  document      String?
  phone         String?
  email         String?
  address       String?
  city          String?
  notes         String?
  tags          String[]
  creditLimit   Decimal  @default(0) @db.Decimal(12, 2) @map("credit_limit")
  accountBalance Decimal @default(0) @db.Decimal(12, 2) @map("account_balance")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")
  company       Company  @relation(fields: [companyId], references: [id])
  vehicles      Vehicle[]
  orders        WorkOrder[]

  @@index([companyId, lastName])
  @@index([document])
  @@map("customers")
}

model Vehicle {
  id           String   @id @default(cuid())
  customerId   String   @map("customer_id")
  plate        String   @unique
  vin          String?
  brand        String
  model        String
  version      String?
  year         Int
  fuel         String?
  transmission String?
  mileage      Int      @default(0)
  color        String?
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  customer     Customer @relation(fields: [customerId], references: [id])
  orders       WorkOrder[]

  @@index([customerId])
  @@index([brand, model])
  @@map("vehicles")
}

model WorkOrder {
  id                String          @id @default(cuid())
  number            Int             @unique @default(autoincrement())
  branchId          String          @map("branch_id")
  customerId        String          @map("customer_id")
  vehicleId         String          @map("vehicle_id")
  status            WorkOrderStatus @default(RECEIVED)
  priority          Priority        @default(NORMAL)
  description       String
  promisedAt        DateTime?       @map("promised_at")
  estimatedTotal    Decimal         @default(0) @db.Decimal(12, 2) @map("estimated_total")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  branch            Branch          @relation(fields: [branchId], references: [id])
  customer          Customer        @relation(fields: [customerId], references: [id])
  vehicle           Vehicle         @relation(fields: [vehicleId], references: [id])
  items             WorkOrderItem[]

  @@index([branchId, status])
  @@index([vehicleId])
  @@map("work_orders")
}

model WorkOrderItem {
  id          String    @id @default(cuid())
  workOrderId String    @map("work_order_id")
  description String
  quantity    Decimal   @default(1) @db.Decimal(10, 2)
  unitPrice   Decimal   @db.Decimal(12, 2) @map("unit_price")
  createdAt   DateTime  @default(now()) @map("created_at")
  updatedAt   DateTime  @updatedAt @map("updated_at")
  workOrder   WorkOrder @relation(fields: [workOrderId], references: [id], onDelete: Cascade)

  @@index([workOrderId])
  @@map("work_order_items")
}

model Setting {
  id        String   @id @default(cuid())
  companyId String   @map("company_id")
  key       String
  value     Json
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@unique([companyId, key])
  @@map("settings")
}

model AuditLog {
  id         String   @id @default(cuid())
  companyId  String   @map("company_id")
  userId     String?  @map("user_id")
  entity     String
  entityId   String   @map("entity_id")
  action     String
  previous   Json?
  next       Json?
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([companyId, createdAt])
  @@map("audit_logs")
}

model Supplier {
  id             String   @id @default(cuid())
  companyId      String   @map("company_id")
  businessName   String   @map("business_name")
  taxId          String?
  contactName    String?  @map("contact_name")
  phone          String?
  email          String?
  address        String?
  paymentTerms   String?  @map("payment_terms")
  notes          String?
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")
  company        Company  @relation(fields: [companyId], references: [id])
  purchaseOrders PurchaseOrder[]

  @@index([companyId, businessName])
  @@map("suppliers")
}

model PurchaseOrder {
  id           String   @id @default(cuid())
  number       Int      @unique @default(autoincrement())
  branchId     String   @map("branch_id")
  supplierId   String   @map("supplier_id")
  purchaseDate DateTime @map("purchase_date")
  status       String   @default("PENDING")
  notes        String?
  total        Decimal  @default(0) @db.Decimal(12, 2)
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")
  branch       Branch   @relation(fields: [branchId], references: [id])
  supplier     Supplier @relation(fields: [supplierId], references: [id])
  items        PurchaseOrderItem[]
  payments     SupplierPayment[]

  @@index([branchId, purchaseDate])
  @@index([supplierId])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id              String        @id @default(cuid())
  purchaseOrderId String        @map("purchase_order_id")
  description     String
  quantity        Decimal       @db.Decimal(10, 2)
  unitPrice       Decimal       @db.Decimal(12, 2) @map("unit_price")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId])
  @@map("purchase_order_items")
}

model SupplierPayment {
  id              String        @id @default(cuid())
  purchaseOrderId String        @map("purchase_order_id")
  paymentDate     DateTime      @map("payment_date")
  amount          Decimal       @db.Decimal(12, 2)
  method          String
  reference       String?
  createdAt       DateTime      @default(now()) @map("created_at")
  purchaseOrder   PurchaseOrder @relation(fields: [purchaseOrderId], references: [id], onDelete: Cascade)

  @@index([purchaseOrderId, paymentDate])
  @@map("supplier_payments")
}
